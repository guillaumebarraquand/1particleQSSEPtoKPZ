/-
Lean proof of Theorem 1.2 of G. Barraquand, "Convergence of the one-particle quantum symmetric
simple exclusion process to the KPZ equation" (2026). Written by Claude (Anthropic) at the
request of the author. See README.md and docs/stage2-design.md.
-/
module

public import QSSEPtoKPZ.Martingales.Defs
public import Mathlib.Probability.Distributions.Gaussian.HasGaussianLaw.Basic
public import Mathlib.Probability.Independence.Integration
public import Mathlib.Probability.Moments.Variance
public import Mathlib.MeasureTheory.Measure.Lebesgue.Basic

/-!
# Moments of Brownian increments against the past (package C, task C1, auxiliary)

For a Brownian family `B` with respect to `𝓖` and times `u ≤ v`, write
`ΔBᵢ(u, v) = Bᵢ(v) - Bᵢ(u)`. We prove, for `𝓖_u`-measurable `η`:

* `IsBrownianFamily.integral_mul_incr`: `𝔼[η ΔBᵢ(u, v)] = 0`;
* `IsBrownianFamily.integral_mul_incr_mul_incr`: `𝔼[η ΔBᵢ(u, v) ΔBⱼ(u, v)] = 𝟙_{i=j} (v - u) 𝔼 η`;
* `IsBrownianFamily.integral_mul_incr_mul_incr_gen`: for two intervals `(u₁, v₁]`, `(u₂, v₂]` and
  bounded `η₁, η₂`, measurable at the left ends,
  `𝔼[η₁ η₂ ΔBᵢ(u₁, v₁) ΔBⱼ(u₂, v₂)] = 𝟙_{i=j} |(u₁, v₁] ∩ (u₂, v₂]| 𝔼[η₁ η₂]`.

These are the only probabilistic inputs of the elementary Itô calculus of `Elementary.lean`.

The one-step computations `setIntegral_add_mul_incr` and `setIntegral_pair_step` combine them
into the martingale property and the bracket of one block, resp. of a pair of blocks.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal

noncomputable section

namespace QSSEPtoKPZ

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {ι : Type*} {𝓖 : Filtration ℝ≥0 mΩ}
  {μ : Measure Ω} {B : ι → ℝ → Ω → ℝ}

namespace IsBrownianFamily

/-- The increment `ΔBᵢ(u, v)` is `𝓖_v`-measurable. -/
lemma measurable_incr (hB : IsBrownianFamily 𝓖 B μ) (i : ι) {u v : ℝ≥0} (huv : u ≤ v) :
    Measurable[𝓖 v] (fun ω => B i v ω - B i u ω) :=
  (hB.adapted i v).sub ((hB.adapted i u).mono (𝓖.mono huv) le_rfl)

/-- The increment `ΔBᵢ(u, v)` has moments of all finite orders. -/
lemma memLp_incr (hB : IsBrownianFamily 𝓖 B μ) (i : ι) {u v : ℝ≥0} (huv : u ≤ v)
    {p : ℝ≥0∞} (hp : p ≠ ∞) : MemLp (fun ω => B i v ω - B i u ω) p μ :=
  (hB.gaussian i u v huv).hasGaussianLaw.memLp hp

/-- The increment `ΔBᵢ(u, v)` is centered. -/
lemma integral_incr (hB : IsBrownianFamily 𝓖 B μ) (i : ι) {u v : ℝ≥0} (huv : u ≤ v) :
    ∫ ω, (B i v ω - B i u ω) ∂μ = 0 := by
  rw [(hB.gaussian i u v huv).integral_eq, integral_id_gaussianReal]

open Classical in
/-- `𝔼[ΔBᵢ(u, v) ΔBⱼ(u, v)] = 𝟙_{i=j} (v - u)`. -/
lemma integral_incr_mul_incr (hB : IsBrownianFamily 𝓖 B μ) (i j : ι) {u v : ℝ≥0}
    (huv : u ≤ v) :
    ∫ ω, (B i v ω - B i u ω) * (B j v ω - B j u ω) ∂μ =
      if i = j then ((v : ℝ) - u) else 0 := by
  have hP : IsProbabilityMeasure μ := (hB.gaussian i u v huv).isProbabilityMeasure
  split_ifs with hij
  · subst hij
    have h := hB.gaussian i u v huv
    simp_rw [← sq]
    rw [← variance_of_integral_eq_zero h.aemeasurable, h.variance_eq, variance_id_gaussianReal,
      NNReal.coe_sub huv]
    rw [h.integral_eq, integral_id_gaussianReal]
  · have hind := (hB.indep u v huv).indepFun hij
    rw [hind.integral_fun_mul_eq_mul_integral
      ((hB.measurable_incr i huv).mono (𝓖.le v) le_rfl).aestronglyMeasurable
      ((hB.measurable_incr j huv).mono (𝓖.le v) le_rfl).aestronglyMeasurable,
      hB.integral_incr i huv, zero_mul]

/-- The σ-algebra generated by the increments on `[u, v]`. -/
abbrev incrSigma (B : ι → ℝ → Ω → ℝ) (u v : ℝ≥0) : MeasurableSpace Ω :=
  ⨆ i : ι, MeasurableSpace.comap (fun ω => B i v ω - B i u ω) inferInstance

lemma measurable_incrSigma (i : ι) (u v : ℝ≥0) :
    Measurable[incrSigma B u v] (fun ω => B i v ω - B i u ω) :=
  (comap_measurable _).mono (le_iSup (fun i => MeasurableSpace.comap
    (fun ω => B i v ω - B i u ω) inferInstance) i) le_rfl

/-- A function of the increments on `[u, v]` is independent of a `𝓖_u`-measurable `η`. -/
lemma indepFun_past (hB : IsBrownianFamily 𝓖 B μ) {u v : ℝ≥0} (huv : u ≤ v) {η Y : Ω → ℝ}
    (hη : Measurable[𝓖 u] η) (hY : Measurable[incrSigma B u v] Y) : IndepFun η Y μ := by
  rw [IndepFun_iff_Indep]
  exact (indep_of_indep_of_le_right (indep_of_indep_of_le_left (hB.indep_past u v huv)
    (measurable_iff_comap_le.1 hY)) (measurable_iff_comap_le.1 hη)).symm

/-- `𝔼[η ΔBᵢ(u, v)] = 0` for `𝓖_u`-measurable `η` (no integrability needed). -/
lemma integral_mul_incr (hB : IsBrownianFamily 𝓖 B μ) (i : ι) {u v : ℝ≥0} (huv : u ≤ v)
    {η : Ω → ℝ} (hη : Measurable[𝓖 u] η) :
    ∫ ω, η ω * (B i v ω - B i u ω) ∂μ = 0 := by
  rw [(hB.indepFun_past huv hη (measurable_incrSigma i u v)).integral_fun_mul_eq_mul_integral
    (hη.mono (𝓖.le u) le_rfl).aestronglyMeasurable
    ((hB.measurable_incr i huv).mono (𝓖.le v) le_rfl).aestronglyMeasurable,
    hB.integral_incr i huv, mul_zero]

open Classical in
/-- `𝔼[η ΔBᵢ(u, v) ΔBⱼ(u, v)] = 𝟙_{i=j} (v - u) 𝔼 η` for `𝓖_u`-measurable `η`. -/
lemma integral_mul_incr_mul_incr (hB : IsBrownianFamily 𝓖 B μ) (i j : ι) {u v : ℝ≥0}
    (huv : u ≤ v) {η : Ω → ℝ} (hη : Measurable[𝓖 u] η) :
    ∫ ω, η ω * ((B i v ω - B i u ω) * (B j v ω - B j u ω)) ∂μ =
      (if i = j then ((v : ℝ) - u) else 0) * ∫ ω, η ω ∂μ := by
  have hY : Measurable[incrSigma B u v]
      (fun ω => (B i v ω - B i u ω) * (B j v ω - B j u ω)) :=
    (measurable_incrSigma i u v).mul (measurable_incrSigma j u v)
  rw [(hB.indepFun_past huv hη hY).integral_fun_mul_eq_mul_integral
    (hη.mono (𝓖.le u) le_rfl).aestronglyMeasurable
    (((hB.measurable_incr i huv).mul (hB.measurable_incr j huv)).mono (𝓖.le v)
      le_rfl).aestronglyMeasurable, hB.integral_incr_mul_incr i j huv, mul_comm]

/-- `ζ X Y` is integrable if `ζ` is bounded and `X, Y ∈ L²`. -/
lemma integrable_bdd_mul_mul {ζ X Y : Ω → ℝ} (hζ : MemLp ζ ∞ μ) (hX : MemLp X 2 μ)
    (hY : MemLp Y 2 μ) : Integrable (fun ω => ζ ω * X ω * Y ω) μ :=
  (MemLp.mul (r := 2) hζ hX).integrable_mul hY

open Classical in
/-- `𝔼[ζ ΔBᵢ(u, v) ΔBⱼ(u, w)] = 𝟙_{i=j} (v ∧ w - u) 𝔼 ζ` for bounded `𝓖_u`-measurable `ζ`. -/
lemma integral_mul_incr_mul_incr' (hB : IsBrownianFamily 𝓖 B μ) (i j : ι) {u v w : ℝ≥0}
    (huv : u ≤ v) (huw : u ≤ w) {ζ : Ω → ℝ} (hζ : Measurable[𝓖 u] ζ) (hζb : MemLp ζ ∞ μ) :
    ∫ ω, ζ ω * ((B i v ω - B i u ω) * (B j w ω - B j u ω)) ∂μ =
      (if i = j then (min (v : ℝ) w - u) else 0) * ∫ ω, ζ ω ∂μ := by
  wlog hvw : v ≤ w generalizing v w i j
  · have h := this j i huw huv (le_of_not_ge hvw)
    simp_rw [mul_comm (B i v _ - B i u _)]
    rw [h, min_comm]
    by_cases hij : i = j
    · subst hij; rfl
    · simp [hij, Ne.symm hij]
  have hsplit : ∀ ω, ζ ω * ((B i v ω - B i u ω) * (B j w ω - B j u ω)) =
      ζ ω * ((B i v ω - B i u ω) * (B j v ω - B j u ω)) +
        ζ ω * (B i v ω - B i u ω) * (B j w ω - B j v ω) := fun ω => by ring
  have h2 : ∀ {a b : ℝ≥0}, a ≤ b → ∀ k, MemLp (fun ω => B k b ω - B k a ω) 2 μ :=
    fun hab k => hB.memLp_incr k hab (by simp)
  simp_rw [hsplit]
  rw [integral_add (by simpa only [mul_assoc] using
      integrable_bdd_mul_mul hζb (h2 huv i) (h2 huv j))
    (integrable_bdd_mul_mul hζb (h2 huv i) (h2 hvw j)),
    hB.integral_mul_incr_mul_incr i j huv hζ,
    hB.integral_mul_incr j hvw (η := fun ω => ζ ω * (B i v ω - B i u ω))
      ((hζ.mono (𝓖.mono huv) le_rfl).mul (hB.measurable_incr i huv)),
    add_zero, min_eq_left (by exact_mod_cast hvw)]

/-- The length of `(u₁, v₁] ∩ (u₂, v₂]`. -/
lemma volume_real_Ioc_inter_Ioc (u₁ v₁ u₂ v₂ : ℝ) :
    volume.real (Set.Ioc u₁ v₁ ∩ Set.Ioc u₂ v₂) = max (min v₁ v₂ - max u₁ u₂) 0 := by
  rw [Set.Ioc_inter_Ioc, Real.volume_real_Ioc]

open Classical in
/-- `𝔼[η₁ η₂ ΔBᵢ(u₁, v₁) ΔBⱼ(u₂, v₂)] = 𝟙_{i=j} |(u₁, v₁] ∩ (u₂, v₂]| 𝔼[η₁ η₂]` for bounded `η₁`,
`η₂`, measurable with respect to `𝓖_{u₁}`, `𝓖_{u₂}`. -/
lemma integral_mul_incr_mul_incr_gen (hB : IsBrownianFamily 𝓖 B μ) (i j : ι)
    {u₁ v₁ u₂ v₂ : ℝ≥0} (h₁ : u₁ ≤ v₁) (h₂ : u₂ ≤ v₂) {η₁ η₂ : Ω → ℝ}
    (hη₁ : Measurable[𝓖 u₁] η₁) (hη₁b : MemLp η₁ ∞ μ)
    (hη₂ : Measurable[𝓖 u₂] η₂) (hη₂b : MemLp η₂ ∞ μ) :
    ∫ ω, η₁ ω * η₂ ω * ((B i v₁ ω - B i u₁ ω) * (B j v₂ ω - B j u₂ ω)) ∂μ =
      (if i = j then volume.real (Set.Ioc (u₁ : ℝ) v₁ ∩ Set.Ioc (u₂ : ℝ) v₂) else 0) *
        ∫ ω, η₁ ω * η₂ ω ∂μ := by
  wlog hu : u₁ ≤ u₂ generalizing u₁ v₁ u₂ v₂ η₁ η₂ i j
  · have h := this j i h₂ h₁ hη₂ hη₂b hη₁ hη₁b (le_of_not_ge hu)
    have e1 : ∀ ω, η₁ ω * η₂ ω * ((B i v₁ ω - B i u₁ ω) * (B j v₂ ω - B j u₂ ω)) =
        η₂ ω * η₁ ω * ((B j v₂ ω - B j u₂ ω) * (B i v₁ ω - B i u₁ ω)) := fun ω => by ring
    simp_rw [e1, h, Set.inter_comm, mul_comm (η₂ _)]
    by_cases hij : i = j
    · subst hij; rfl
    · simp [hij, Ne.symm hij]
  have hζ : Measurable[𝓖 u₂] (fun ω => η₁ ω * η₂ ω) := (hη₁.mono (𝓖.mono hu) le_rfl).mul hη₂
  have hζb : MemLp (fun ω => η₁ ω * η₂ ω) ∞ μ := hη₁b.mul hη₂b
  have h2 : ∀ {a b : ℝ≥0}, a ≤ b → ∀ k, MemLp (fun ω => B k b ω - B k a ω) 2 μ :=
    fun hab k => hB.memLp_incr k hab (by simp)
  rw [volume_real_Ioc_inter_Ioc]
  by_cases hv : v₁ ≤ u₂
  · have e1 : ∀ ω, η₁ ω * η₂ ω * ((B i v₁ ω - B i u₁ ω) * (B j v₂ ω - B j u₂ ω)) =
        (η₁ ω * η₂ ω * (B i v₁ ω - B i u₁ ω)) * (B j v₂ ω - B j u₂ ω) := fun ω => by ring
    simp_rw [e1]
    rw [hB.integral_mul_incr j h₂ (η := fun ω => η₁ ω * η₂ ω * (B i v₁ ω - B i u₁ ω))
      (hζ.mul ((hB.measurable_incr i h₁).mono (𝓖.mono hv) le_rfl))]
    have : max (min (v₁ : ℝ) v₂ - max (u₁ : ℝ) u₂) 0 = 0 := by
      apply max_eq_right
      have : (v₁ : ℝ) ≤ u₂ := by exact_mod_cast hv
      linarith [min_le_left (v₁ : ℝ) v₂, le_max_right (u₁ : ℝ) u₂]
    simp [this]
  · push Not at hv
    have e1 : ∀ ω, η₁ ω * η₂ ω * ((B i v₁ ω - B i u₁ ω) * (B j v₂ ω - B j u₂ ω)) =
        (η₁ ω * η₂ ω * (B i u₂ ω - B i u₁ ω)) * (B j v₂ ω - B j u₂ ω) +
          η₁ ω * η₂ ω * ((B i v₁ ω - B i u₂ ω) * (B j v₂ ω - B j u₂ ω)) := fun ω => by ring
    simp_rw [e1]
    rw [integral_add (integrable_bdd_mul_mul hζb (h2 hu i) (h2 h₂ j))
      (by simpa only [mul_assoc] using integrable_bdd_mul_mul hζb (h2 hv.le i) (h2 h₂ j)),
      hB.integral_mul_incr j h₂ (η := fun ω => η₁ ω * η₂ ω * (B i u₂ ω - B i u₁ ω))
        (hζ.mul (hB.measurable_incr i hu)),
      hB.integral_mul_incr_mul_incr' i j hv.le h₂ hζ hζb, zero_add]
    have hv' : (u₂ : ℝ) < v₁ := by exact_mod_cast hv
    have h₂' : (u₂ : ℝ) ≤ v₂ := by exact_mod_cast h₂
    have hu' : (u₁ : ℝ) ≤ u₂ := by exact_mod_cast hu
    rw [max_eq_right hu', max_eq_left (by simp [hv'.le, h₂'])]

end IsBrownianFamily

/-! ### The one-step computations behind the elementary martingales -/

/-- A set integral as the integral of `𝟙_A f`. -/
lemma setIntegral_eq_integral_indicator_mul {A : Set Ω} (hA : MeasurableSet A) (f : Ω → ℝ) :
    ∫ ω in A, f ω ∂μ = ∫ ω, A.indicator (fun _ => (1 : ℝ)) ω * f ω ∂μ := by
  rw [← integral_indicator hA]
  congr 1
  funext ω
  by_cases h : ω ∈ A <;> simp [h]

/-- The indicator of a set is bounded. -/
lemma memLp_indicator_one {A : Set Ω} (hA : MeasurableSet A) :
    MemLp (A.indicator (fun _ => (1 : ℝ))) ∞ μ :=
  memLp_top_of_bound (measurable_const.indicator hA).aestronglyMeasurable 1
    (ae_of_all _ fun ω => by by_cases h : ω ∈ A <;> simp [h])

/-- `ζ X` is integrable if `ζ` is bounded and `X` integrable. -/
lemma integrable_bdd_mul {ζ X : Ω → ℝ} (hζ : MemLp ζ ∞ μ) (hX : Integrable X μ) :
    Integrable (fun ω => ζ ω * X ω) μ :=
  hζ.integrable_mul (memLp_one_iff_integrable.2 hX)

namespace IsBrownianFamily

/-- **One step of the martingale property.** For `A ∈ 𝓖_s`, `s ≤ u ≤ v`, and `ξ` bounded and
`𝓖_u`-measurable, `∫_A (M + ξ ΔBᵢ(u, v)) = ∫_A M`. -/
lemma setIntegral_add_mul_incr (hB : IsBrownianFamily 𝓖 B μ) [IsProbabilityMeasure μ]
    {s u v : ℝ≥0} {A : Set Ω} (hA : MeasurableSet[𝓖 s] A) (i : ι) (hsu : s ≤ u) (huv : u ≤ v)
    {ξ M : Ω → ℝ} (hξ : Measurable[𝓖 u] ξ) (hξb : MemLp ξ ∞ μ) (hM : Integrable M μ) :
    ∫ ω in A, (M ω + ξ ω * (B i v ω - B i u ω)) ∂μ = ∫ ω in A, M ω ∂μ := by
  have hA' : MeasurableSet A := 𝓖.le s _ hA
  have hint : Integrable (fun ω => ξ ω * (B i v ω - B i u ω)) μ :=
    (MemLp.mul (r := 2) hξb (hB.memLp_incr (p := 2) i huv (by simp))).integrable (by simp)
  rw [integral_add hM.integrableOn hint.integrableOn, add_eq_left,
    setIntegral_eq_integral_indicator_mul hA']
  simp_rw [← mul_assoc]
  exact hB.integral_mul_incr i huv
    (((measurable_const.indicator hA).mono (𝓖.mono hsu) le_rfl).mul hξ)

open Classical in
/-- **One step of the bracket computation.** For `A ∈ 𝓖_s`, `s ≤ uₖ ≤ vₖ`, `ξₖ` bounded and
`𝓖_{uₖ}`-measurable, `Mₖ ∈ L²` `𝓖_s`-measurable, `c = 𝟙_{i=j} ξ₁ ξ₂` and `ℓ = |(u₁,v₁] ∩ (u₂,v₂]|`:
`∫_A ((M₁ + ξ₁ ΔBᵢ(u₁,v₁)) (M₂ + ξ₂ ΔBⱼ(u₂,v₂)) - (L + ℓ) c) = ∫_A (M₁ M₂ - L c)`. -/
lemma setIntegral_pair_step (hB : IsBrownianFamily 𝓖 B μ) [IsProbabilityMeasure μ]
    {s : ℝ≥0} {A : Set Ω} (hA : MeasurableSet[𝓖 s] A) (i j : ι) {u₁ v₁ u₂ v₂ : ℝ≥0}
    (hs₁ : s ≤ u₁) (h₁ : u₁ ≤ v₁) (hs₂ : s ≤ u₂) (h₂ : u₂ ≤ v₂) {ξ₁ ξ₂ M₁ M₂ : Ω → ℝ}
    (hξ₁ : Measurable[𝓖 u₁] ξ₁) (hξ₁b : MemLp ξ₁ ∞ μ)
    (hξ₂ : Measurable[𝓖 u₂] ξ₂) (hξ₂b : MemLp ξ₂ ∞ μ)
    (hM₁ : Measurable[𝓖 s] M₁) (hM₁b : MemLp M₁ 2 μ)
    (hM₂ : Measurable[𝓖 s] M₂) (hM₂b : MemLp M₂ 2 μ) (L : ℝ) {c : Ω → ℝ}
    (hc : c = fun ω => if i = j then ξ₁ ω * ξ₂ ω else 0) :
    ∫ ω in A, ((M₁ ω + ξ₁ ω * (B i v₁ ω - B i u₁ ω)) * (M₂ ω + ξ₂ ω * (B j v₂ ω - B j u₂ ω)) -
        (L + volume.real (Set.Ioc (u₁ : ℝ) v₁ ∩ Set.Ioc (u₂ : ℝ) v₂)) * c ω) ∂μ =
      ∫ ω in A, (M₁ ω * M₂ ω - L * c ω) ∂μ := by
  have hA' : MeasurableSet A := 𝓖.le s _ hA
  rw [setIntegral_eq_integral_indicator_mul hA', setIntegral_eq_integral_indicator_mul hA']
  have e3 := hB.integral_mul_incr_mul_incr_gen i j h₁ h₂
    (η₁ := fun ω => A.indicator (fun _ => (1 : ℝ)) ω * ξ₁ ω)
    (((measurable_const.indicator hA).mono (𝓖.mono hs₁) le_rfl).mul hξ₁)
    ((memLp_indicator_one hA').mul hξ₁b) hξ₂ hξ₂b
  generalize hℓ : volume.real (Set.Ioc (u₁ : ℝ) v₁ ∩ Set.Ioc (u₂ : ℝ) v₂) = ℓ at e3 ⊢
  have hind : Measurable[𝓖 s] (A.indicator (fun _ => (1 : ℝ))) :=
    measurable_const.indicator hA
  have hindb : MemLp (A.indicator (fun _ => (1 : ℝ))) ∞ μ := memLp_indicator_one hA'
  generalize A.indicator (fun _ => (1 : ℝ)) = ind at e3 hind hindb ⊢
  have h2 : ∀ {a b : ℝ≥0}, a ≤ b → ∀ k, MemLp (fun ω => B k b ω - B k a ω) 2 μ :=
    fun hab k => hB.memLp_incr k hab (by simp)
  have hcb : MemLp c ∞ μ := by
    rw [hc]; split_ifs
    · exact hξ₁b.mul hξ₂b
    · exact memLp_top_const 0
  have hRint : Integrable (fun ω => M₁ ω * M₂ ω - L * c ω) μ :=
    (hM₁b.integrable_mul hM₂b).sub ((hcb.const_mul L).integrable le_top)
  have key : ∀ ω, ind ω * ((M₁ ω + ξ₁ ω * (B i v₁ ω - B i u₁ ω)) *
      (M₂ ω + ξ₂ ω * (B j v₂ ω - B j u₂ ω)) - (L + ℓ) * c ω) =
      ind ω * (M₁ ω * M₂ ω - L * c ω) +
        (ind ω * ξ₂ ω * M₁ ω * (B j v₂ ω - B j u₂ ω) +
          ind ω * ξ₁ ω * M₂ ω * (B i v₁ ω - B i u₁ ω) +
          ind ω * ξ₁ ω * ξ₂ ω * ((B i v₁ ω - B i u₁ ω) * (B j v₂ ω - B j u₂ ω)) -
          ℓ * (ind ω * c ω)) := fun ω => by ring
  have i1 : Integrable (fun ω => ind ω * ξ₂ ω * M₁ ω * (B j v₂ ω - B j u₂ ω)) μ :=
    integrable_bdd_mul_mul (hindb.mul hξ₂b) hM₁b (h2 h₂ j)
  have i2 : Integrable (fun ω => ind ω * ξ₁ ω * M₂ ω * (B i v₁ ω - B i u₁ ω)) μ :=
    integrable_bdd_mul_mul (hindb.mul hξ₁b) hM₂b (h2 h₁ i)
  have i3 : Integrable (fun ω => ind ω * ξ₁ ω * ξ₂ ω *
      ((B i v₁ ω - B i u₁ ω) * (B j v₂ ω - B j u₂ ω))) μ := by
    refine (integrable_bdd_mul_mul (ζ := fun ω => ind ω * ξ₁ ω * ξ₂ ω)
      (MemLp.mul (r := ∞) (MemLp.mul (r := ∞) hindb hξ₁b) hξ₂b) (h2 h₁ i) (h2 h₂ j)).congr
      (ae_of_all _ fun ω => ?_)
    simp only
    ring
  have i4 : Integrable (fun ω => ℓ * (ind ω * c ω)) μ :=
    (((MemLp.mul (r := ∞) hindb hcb).const_mul ℓ).integrable le_top)
  have i12 : Integrable (fun ω => ind ω * ξ₂ ω * M₁ ω * (B j v₂ ω - B j u₂ ω) +
      ind ω * ξ₁ ω * M₂ ω * (B i v₁ ω - B i u₁ ω)) μ := i1.add i2
  have i123 : Integrable (fun ω => ind ω * ξ₂ ω * M₁ ω * (B j v₂ ω - B j u₂ ω) +
      ind ω * ξ₁ ω * M₂ ω * (B i v₁ ω - B i u₁ ω) +
      ind ω * ξ₁ ω * ξ₂ ω * ((B i v₁ ω - B i u₁ ω) * (B j v₂ ω - B j u₂ ω))) μ := i12.add i3
  have i1234 : Integrable (fun ω => ind ω * ξ₂ ω * M₁ ω * (B j v₂ ω - B j u₂ ω) +
      ind ω * ξ₁ ω * M₂ ω * (B i v₁ ω - B i u₁ ω) +
      ind ω * ξ₁ ω * ξ₂ ω * ((B i v₁ ω - B i u₁ ω) * (B j v₂ ω - B j u₂ ω)) -
      ℓ * (ind ω * c ω)) μ := i123.sub i4
  simp_rw [key]
  rw [integral_add (integrable_bdd_mul hindb hRint) i1234, add_eq_left,
    integral_sub i123 i4, integral_add i12 i3, integral_add i1 i2]
  have e1 : ∫ ω, ind ω * ξ₂ ω * M₁ ω * (B j v₂ ω - B j u₂ ω) ∂μ = 0 :=
    hB.integral_mul_incr j h₂ (η := fun ω => ind ω * ξ₂ ω * M₁ ω)
      (((hind.mono (𝓖.mono hs₂) le_rfl).mul hξ₂).mul (hM₁.mono (𝓖.mono hs₂) le_rfl))
  have e2 : ∫ ω, ind ω * ξ₁ ω * M₂ ω * (B i v₁ ω - B i u₁ ω) ∂μ = 0 :=
    hB.integral_mul_incr i h₁ (η := fun ω => ind ω * ξ₁ ω * M₂ ω)
      (((hind.mono (𝓖.mono hs₁) le_rfl).mul hξ₁).mul (hM₂.mono (𝓖.mono hs₁) le_rfl))
  rw [e1, e2, e3, integral_const_mul]
  by_cases hij : i = j
  · simp [hc, hij, mul_assoc]
  · simp [hc, hij]

end IsBrownianFamily

