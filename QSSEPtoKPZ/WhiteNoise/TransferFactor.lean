/-
Lean proof of Theorem 1.2 of G. Barraquand, "Convergence of the one-particle quantum symmetric
simple exclusion process to the KPZ equation" (2026). Written by Claude (Anthropic) at the
request of the author. See README.md and docs/stage4-design.md.
-/
module

public import QSSEPtoKPZ.WhiteNoise.Projection
public import Mathlib.MeasureTheory.Function.FactorsThrough

/-!
# Walsh integrals for the noise filtration are functions of the noise (task G6)

Preparation of `IsWalshIntegral.transfer`. Let `ξ` be a white noise with noise coordinates
`N = noiseMap S : Ω → W`, `W = (ℝ≥0 × ℝ × ℝ → ℝ)`, and `𝒩` its natural filtration (augmented
by the null sets).

* `noiseAugSets 𝒜 P`: the measurable sets that are `P`-a.e. equal to a set of `𝒜`; it contains
  `𝒜 ∨ (null sets)` (`noiseAug_le`), also on a product (`noiseAug_prod`), and conditional
  expectations given `𝒜` and given any `𝒜' ⊆ noiseAugSets 𝒜 P` containing `𝒜` agree
  (`noiseAug_condExp_eq`).
* `noisePathSigma s`: the σ-algebra on `W` of the coordinates `w(u, a, b)`, `u ≤ s`;
  `𝒩_s ⊆ σ(N)_s ∨ (null sets)` and `σ(N)_s = N⁻¹(noisePathSigma s) ⊆ 𝒩_s`.
* Doob–Dynkin: a bounded `𝒩_s`-measurable variable is a.s. `c₀ ∘ N` with `c₀`
  `noisePathSigma s`-measurable (`IsWhiteNoise.exists_noisePath_factor`); the integrand and the
  value of a Walsh integral for `𝒩` are a.e. `H(N, s, y)` and `Ξ(N)` with `H`, `Ξ` measurable
  (`IsWhiteNoise.exists_noiseMap_factor`). For the integrand this goes through the projection
  `noiseProj`, which fixes it (`IsWhiteNoise.walsh_noise_fixed`), and a conditional expectation
  on `Ω × ℝ²` given `σ(N) ⊗ 𝓑(ℝ²)`.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal

noncomputable section

namespace QSSEPtoKPZ

/-! ### Augmentation by null sets -/

/-- The σ-algebra of the `mX`-measurable sets that are `P`-a.e. equal to a set of `𝒜`. -/
@[instance_reducible] def noiseAugSets {X : Type*} (𝒜 : MeasurableSpace X) {mX : MeasurableSpace X} (P : Measure X) :
    MeasurableSpace X where
  MeasurableSet' A := MeasurableSet[mX] A ∧ ∃ A', MeasurableSet[𝒜] A' ∧ A =ᵐ[P] A'
  measurableSet_empty := ⟨MeasurableSet.empty, ∅, @MeasurableSet.empty _ 𝒜, ae_eq_refl _⟩
  measurableSet_compl A hA := by
    obtain ⟨hAm, A', hA', hAA'⟩ := hA
    exact ⟨hAm.compl, A'ᶜ, hA'.compl, hAA'.compl⟩
  measurableSet_iUnion f hf := by
    choose hfm g hg hfg using hf
    exact ⟨MeasurableSet.iUnion hfm, ⋃ i, g i, MeasurableSet.iUnion hg,
      EventuallyEqSet.countable_iUnion hfg⟩

section Aug

variable {X : Type*} {𝒜 𝒜' : MeasurableSpace X} {mX : MeasurableSpace X} {P : Measure X}

/-- `𝒜 ∨ (null sets) ⊆ noiseAugSets 𝒜 P`. -/
theorem noiseAug_le (h𝒜 : 𝒜 ≤ mX) : 𝒜 ⊔ nullSets P ≤ noiseAugSets 𝒜 P := by
  refine sup_le (fun A hA => ⟨h𝒜 _ hA, A, hA, ae_eq_refl _⟩) ?_
  exact MeasurableSpace.generateFrom_le fun A hA =>
    ⟨hA.1, ∅, @MeasurableSet.empty _ 𝒜, ae_eq_empty.2 hA.2⟩

/-- Conditional expectations given `𝒜` and given `𝒜'`, with `𝒜 ⊆ 𝒜' ⊆ noiseAugSets 𝒜 P`,
agree almost everywhere. -/
theorem noiseAug_condExp_eq [IsFiniteMeasure P] (h𝒜' : 𝒜' ≤ mX) (h1 : 𝒜 ≤ 𝒜')
    (h2 : 𝒜' ≤ noiseAugSets 𝒜 P) {f : X → ℝ} (hf : Integrable f P) :
    P[f | 𝒜'] =ᵐ[P] P[f | 𝒜] := by
  refine (ae_eq_condExp_of_forall_setIntegral_eq h𝒜' hf
    (fun _ _ _ => integrable_condExp.integrableOn) (fun A hA _ => ?_)
    (stronglyMeasurable_condExp.mono h1).aestronglyMeasurable).symm
  obtain ⟨-, A', hA', hAA'⟩ := h2 _ hA
  rw [setIntegral_congr_set hAA', setIntegral_congr_set hAA',
    setIntegral_condExp (h1.trans h𝒜') hf hA']

end Aug

/-- On a product, `(𝒜 ∨ (null sets of ν)) ⊗ 𝓨 ⊆ noiseAugSets (𝒜 ⊗ 𝓨) (ν ⊗ τ)`. -/
theorem noiseAug_prod {Ω Y : Type*} {𝒜 : MeasurableSpace Ω} {mΩ : MeasurableSpace Ω}
    {mY : MeasurableSpace Y} {ν : Measure Ω} {τ : Measure Y} [SFinite τ] (h𝒜 : 𝒜 ≤ mΩ) :
    (𝒜 ⊔ nullSets ν).prod mY ≤ noiseAugSets (𝒜.prod mY) (ν.prod τ) := by
  refine sup_le ?_ ?_
  · rw [MeasurableSpace.comap_le_iff_le_map]
    intro A hA
    obtain ⟨hAm, A', hA', hAA'⟩ := noiseAug_le (P := ν) h𝒜 A hA
    exact ⟨measurable_fst hAm, Prod.fst ⁻¹' A', le_sup_left (a := MeasurableSpace.comap
      Prod.fst 𝒜) _ ⟨A', hA', rfl⟩, Measure.quasiMeasurePreserving_fst.preimage_ae_eq hAA'⟩
  · intro A hA
    exact ⟨sup_le_sup (MeasurableSpace.comap_mono h𝒜) le_rfl _ (le_sup_right (b :=
      MeasurableSpace.comap Prod.snd mY) _ hA), A, le_sup_right (a := MeasurableSpace.comap
      Prod.fst 𝒜) _ hA, ae_eq_refl _⟩

/-! ### The noise coordinates up to time `s` -/

/-- The σ-algebra on the path space `W = (ℝ≥0 × ℝ × ℝ → ℝ)` generated by the coordinates
`w(u, a, b)` with `u ≤ s`. -/
@[instance_reducible] def noisePathSigma (s : ℝ≥0) : MeasurableSpace (ℝ≥0 × ℝ × ℝ → ℝ) :=
  ⨆ (p : ℝ≥0 × ℝ × ℝ) (_ : p.1 ≤ s), MeasurableSpace.comap (fun w => w p) (borel ℝ)

/-- `noisePathSigma s` is contained in the product σ-algebra. -/
theorem noisePathSigma_le (s : ℝ≥0) : noisePathSigma s ≤ MeasurableSpace.pi :=
  iSup₂_le fun p _ => by
    rw [← BorelSpace.measurable_eq]
    exact (measurable_pi_apply p).comap_le

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {𝓖 : Filtration ℝ≥0 mΩ} {S : ℝ → ℝ → Ω → ℝ}
  {ν : Measure Ω}

/-- `N⁻¹(noisePathSigma s) ⊆ 𝓕` as soon as the coordinates up to time `s` are
`𝓕`-measurable. -/
private lemma noise_comap_le_aux {𝓕 : MeasurableSpace Ω} {s : ℝ≥0}
    (h : ∀ p : ℝ≥0 × ℝ × ℝ, p.1 ≤ s → Measurable[𝓕] (rectMass S 0 p.1 p.2.1 p.2.2)) :
    MeasurableSpace.comap (noiseMap S) (noisePathSigma s) ≤ 𝓕 := by
  simp only [noisePathSigma, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  exact iSup₂_le fun p hp => (h p hp).comap_le

/-- For a white noise for `𝓖`, `N⁻¹(noisePathSigma s) ⊆ 𝓖_s`. -/
theorem IsWhiteNoise.noiseMap_comap_pathSigma_le (hS : IsWhiteNoise 𝓖 S ν) (s : ℝ≥0) :
    MeasurableSpace.comap (noiseMap S) (noisePathSigma s) ≤ 𝓖 s :=
  noise_comap_le_aux fun _ hp => hS.measurable_noiseCoord_le hp _ _

/-- For a white noise, `N⁻¹(noisePathSigma s) ⊆ 𝒩_s`. -/
private lemma IsWhiteNoise.noise_comap_le_filtration (hS : IsWhiteNoise 𝓖 S ν) (s : ℝ≥0) :
    MeasurableSpace.comap (noiseMap S) (noisePathSigma s) ≤ noiseFiltration S ν s := by
  have := hS.noiseSheet.noiseMap_comap_pathSigma_le s
  rwa [noiseMap_noiseSheet] at this

/-- `𝒩_s ⊆ N⁻¹(noisePathSigma s) ∨ (null sets)`. -/
private lemma noise_filtration_le_comap (S : ℝ → ℝ → Ω → ℝ) (ν : Measure Ω) (s : ℝ≥0) :
    noiseFiltration S ν s ≤ MeasurableSpace.comap (noiseMap S) (noisePathSigma s) ⊔ nullSets ν := by
  refine sup_le_sup_right (inf_le_left.trans (iSup₂_le fun u hu => iSup₂_le fun a b => ?_)) _
  rw [show rectMass S 0 u a b = (fun w => w (u, a, b)) ∘ noiseMap S from rfl,
    ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (le_iSup₂_of_le (f := fun (p : ℝ≥0 × ℝ × ℝ) (_ : p.1 ≤ s) =>
    MeasurableSpace.comap (fun w : ℝ≥0 × ℝ × ℝ → ℝ => w p) (borel ℝ)) (u, a, b) hu le_rfl)

/-- `𝒩_∞ ⊆ σ(N) ∨ (null sets)`. -/
private lemma noise_iSup_le_comap (S : ℝ → ℝ → Ω → ℝ) (ν : Measure Ω) :
    (⨆ t, noiseFiltration S ν t) ≤ MeasurableSpace.comap (noiseMap S) MeasurableSpace.pi ⊔
      nullSets ν :=
  iSup_le fun s => (noise_filtration_le_comap S ν s).trans
    (sup_le_sup_right (MeasurableSpace.comap_mono (noisePathSigma_le s)) _)

/-- A map into the path space is measurable if its coordinates are. -/
private lemma noise_measurable_pi {α : Type*} [MeasurableSpace α]
    {N : α → ℝ≥0 × ℝ × ℝ → ℝ} (h : ∀ p, Measurable fun a => N a p) : Measurable N :=
  measurable_pi_iff.2 h

/-- For a white noise, the noise coordinates are `𝒩_∞`-measurable: `σ(N) ⊆ 𝒩_∞`. -/
theorem IsWhiteNoise.noiseMap_comap_le_iSup (hS : IsWhiteNoise 𝓖 S ν) :
    MeasurableSpace.comap (noiseMap S) MeasurableSpace.pi ≤ ⨆ t, noiseFiltration S ν t := by
  rw [← measurable_iff_comap_le]
  refine @noise_measurable_pi Ω (⨆ t, noiseFiltration S ν t) _ fun p => ?_
  have h1 := hS.noiseSheet.measurable_noiseCoord_le (le_refl p.1) p.2.1 p.2.2
  have e : rectMass (QSSEPtoKPZ.noiseSheet S) 0 p.1 p.2.1 p.2.2 = rectMass S 0 p.1 p.2.1 p.2.2 :=
    funext (rectMass_noiseSheet S 0 p.1 p.2.1 p.2.2)
  rw [e] at h1
  exact h1.mono (le_iSup (fun u => (noiseFiltration S ν u : MeasurableSpace Ω)) p.1) le_rfl

/-! ### Doob–Dynkin factorizations -/

/-- **A `𝒩_s`-measurable variable is a function of the noise up to time `s`**:
`c = c₀ ∘ N` a.s. with `c₀` `noisePathSigma s`-measurable. -/
theorem IsWhiteNoise.exists_noisePath_factor (hS : IsWhiteNoise 𝓖 S ν) {s : ℝ≥0} {c : Ω → ℝ}
    (hc : Measurable[noiseFiltration S ν s] c) (hci : Integrable c ν) :
    ∃ c₀ : (ℝ≥0 × ℝ × ℝ → ℝ) → ℝ, Measurable[noisePathSigma s] c₀ ∧
      c =ᵐ[ν] fun ω => c₀ (noiseMap S ω) := by
  have : IsProbabilityMeasure ν := hS.isProbabilityMeasure
  have hle : (noiseFiltration S ν s : MeasurableSpace Ω) ≤ mΩ := (noiseFiltration S ν).le s
  have hNle := hS.noise_comap_le_filtration s
  have e1 := noiseAug_condExp_eq (P := ν) hle hNle
    ((noise_filtration_le_comap S ν s).trans (noiseAug_le (hNle.trans hle))) hci
  rw [condExp_of_stronglyMeasurable hle hc.stronglyMeasurable hci] at e1
  obtain ⟨c₀, hc₀, hc₀e⟩ := StronglyMeasurable.exists_eq_measurable_comp (mY := noisePathSigma s)
    (f := noiseMap S) (stronglyMeasurable_condExp (m := MeasurableSpace.comap (noiseMap S)
      (noisePathSigma s)) (μ := ν) (f := c))
  exact ⟨c₀, hc₀.measurable, e1.trans (EventuallyEq.of_eq hc₀e)⟩

/-- **Fields and variables fixed by the projection onto the noise.** For a Walsh integral for
the noise filtration, `ĥ = h` and `𝔼[X | 𝒩_∞] = X` almost everywhere. -/
theorem IsWhiteNoise.walsh_noise_fixed (hS : IsWhiteNoise 𝓖 S ν) {h : ℝ → ℝ → Ω → ℝ}
    {X : Ω → ℝ} (hX : IsWalshIntegral (noiseFiltration S ν) S ν h X) :
    uncurryField h =ᵐ[ν.prod volume] uncurryField (noiseProj S ν h) ∧
      X =ᵐ[ν] ν[X | ⨆ t, noiseFiltration S ν t] := by
  have : IsProbabilityMeasure ν := hS.isProbabilityMeasure
  have hS' := hS.noiseSheet
  have h𝒢 := noiseProj_iSup_le (mΩ := mΩ) S ν
  have hiso : ∀ {h : ℝ → ℝ → Ω → ℝ} {X : Ω → ℝ},
      IsWalshIntegral (noiseFiltration S ν) S ν h X →
      MemLp (uncurryField h) 2 (ν.prod volume) ∧ MemLp X 2 ν := fun hX =>
    let h := IsWalshIntegral.isometry_lib hS' (isWalshIntegral_noiseSheet_iff.2 hX)
    ⟨h.1, h.2.1⟩
  induction hX with
  | block s t a b c hst hab hc hbdd =>
    obtain ⟨C, hC⟩ := hbdd
    have hcN : Measurable[⨆ t, noiseFiltration S ν t] c :=
      hc.mono (le_iSup (fun u => (noiseFiltration S ν u : MeasurableSpace Ω)) s) le_rfl
    have hcm : Measurable c := hcN.mono h𝒢 le_rfl
    have hci : Integrable c ν :=
      Integrable.of_bound hcm.aestronglyMeasurable C (ae_of_all _ fun ω => by
        rw [Real.norm_eq_abs]; exact hC ω)
    have hce : ν[c | ⨆ t, noiseFiltration S ν t] = c :=
      condExp_of_stronglyMeasurable h𝒢 hcN.stronglyMeasurable hci
    refine ⟨?_, ?_⟩
    · refine EventuallyEq.symm ((noiseProj_block S hcm hC s t a b).trans ?_)
      rw [hce]
    · have hrm : Measurable[⨆ t, noiseFiltration S ν t] (rectMass S s t a b) := by
        have h1 := hS'.measurable_rectMass_noise_le hst (le_refl t) a b
        have e : rectMass (QSSEPtoKPZ.noiseSheet S) s t a b = rectMass S s t a b :=
          funext (rectMass_noiseSheet S s t a b)
        rw [e] at h1
        exact h1.mono (le_iSup (fun u => (noiseFiltration S ν u : MeasurableSpace Ω)) t) le_rfl
      have hXi := ((hiso (IsWalshIntegral.block (𝓖 := noiseFiltration S ν) (S := S) (ν := ν)
        s t a b c hst hab hc ⟨C, hC⟩)).2).integrable one_le_two
      have hm2 : StronglyMeasurable[⨆ t, noiseFiltration S ν t]
          (fun ω => c ω * rectMass S s t a b ω) := (hcN.mul hrm).stronglyMeasurable
      rw [condExp_of_stronglyMeasurable h𝒢 hm2 hXi]
  | add h h' X X' hX hX' ih ih' =>
    obtain ⟨hh, hX2⟩ := hiso hX
    obtain ⟨hh', hX2'⟩ := hiso hX'
    refine ⟨?_, ?_⟩
    · refine EventuallyEq.trans ?_ (noiseProj_add S hh hh').symm
      filter_upwards [ih.1, ih'.1] with p e1 e2
      simp only [uncurryField] at e1 e2 ⊢
      rw [e1, e2]
    · refine EventuallyEq.trans ?_
        (condExp_add (hX2.integrable one_le_two) (hX2'.integrable one_le_two) _).symm
      filter_upwards [ih.2, ih'.2] with ω e1 e2
      simp only [Pi.add_apply]
      rw [← e1, ← e2]
  | limit h X hs Xs hXs hh hX hhs hXs' ih =>
    refine ⟨?_, ?_⟩
    · have hbound : ∀ k, eLpNorm (uncurryField h - uncurryField (noiseProj S ν h)) 2
          (ν.prod volume) ≤ eLpNorm (uncurryField (hs k) - uncurryField h) 2 (ν.prod volume) +
          eLpNorm (uncurryField (hs k) - uncurryField h) 2 (ν.prod volume) := by
        intro k
        have hk := (hiso (hXs k)).1
        have e : uncurryField h - uncurryField (noiseProj S ν h) =ᵐ[ν.prod volume]
            (uncurryField h - uncurryField (hs k)) +
            uncurryField (noiseProj S ν fun s y ω => hs k s y ω - h s y ω) := by
          filter_upwards [noiseProj_sub S hk hh, (ih k).1] with p e1 e2
          simp only [Pi.add_apply, Pi.sub_apply] at e1 e2 ⊢
          rw [e1, ← e2]
          ring
        rw [eLpNorm_congr_ae e]
        refine (eLpNorm_add_le one_le_two).trans (add_le_add (le_of_eq ?_)
          (noiseProj_memLp S (h := fun s y ω => hs k s y ω - h s y ω) (hk.sub hh)).2)
        rw [← eLpNorm_neg]
        congr 1
        abel
      have hlim : Tendsto (fun k => eLpNorm (uncurryField (hs k) - uncurryField h) 2
          (ν.prod volume) + eLpNorm (uncurryField (hs k) - uncurryField h) 2 (ν.prod volume))
          atTop (𝓝 0) := by
        simpa using hhs.add hhs
      have h0 := le_antisymm (ge_of_tendsto' hlim hbound) zero_le
      rw [eLpNorm_eq_zero_iff two_ne_zero] at h0
      filter_upwards [h0] with p hp
      exact sub_eq_zero.1 hp
    · have hbound : ∀ k, eLpNorm (X - ν[X | ⨆ t, noiseFiltration S ν t]) 2 ν ≤
          eLpNorm (Xs k - X) 2 ν + eLpNorm (Xs k - X) 2 ν := by
        intro k
        have hk := ((hiso (hXs k)).2).integrable one_le_two
        have e : X - ν[X | ⨆ t, noiseFiltration S ν t] =ᵐ[ν] (X - Xs k) +
            ν[Xs k - X | ⨆ t, noiseFiltration S ν t] := by
          filter_upwards [condExp_sub hk (hX.integrable one_le_two) (⨆ t, noiseFiltration S ν t),
            (ih k).2] with ω e1 e2
          simp only [Pi.add_apply, Pi.sub_apply] at e1 ⊢
          rw [e1, ← e2]
          ring
        rw [eLpNorm_congr_ae e]
        refine (eLpNorm_add_le one_le_two).trans (add_le_add (le_of_eq ?_)
          (eLpNorm_condExp_le_eLpNorm _ one_le_two))
        rw [← eLpNorm_neg]
        congr 1
        abel
      have hlim : Tendsto (fun k => eLpNorm (Xs k - X) 2 ν + eLpNorm (Xs k - X) 2 ν) atTop
          (𝓝 0) := by
        simpa using hXs'.add hXs'
      have h0 := le_antisymm (ge_of_tendsto' hlim hbound) zero_le
      rw [eLpNorm_eq_zero_iff two_ne_zero] at h0
      filter_upwards [h0] with ω hω
      exact sub_eq_zero.1 hω

/-- **Doob–Dynkin for Walsh integrals for the noise filtration**: the integrand and the value
are a.e. `H(N, s, y)` and `Ξ(N)` with `H`, `Ξ` measurable. -/
theorem IsWhiteNoise.exists_noiseMap_factor (hS : IsWhiteNoise 𝓖 S ν) {h : ℝ → ℝ → Ω → ℝ}
    {X : Ω → ℝ} (hX : IsWalshIntegral (noiseFiltration S ν) S ν h X) :
    ∃ (H : (ℝ≥0 × ℝ × ℝ → ℝ) → ℝ → ℝ → ℝ) (Ξ : (ℝ≥0 × ℝ × ℝ → ℝ) → ℝ),
      Measurable (fun p : (ℝ≥0 × ℝ × ℝ → ℝ) × ℝ × ℝ => H p.1 p.2.1 p.2.2) ∧ Measurable Ξ ∧
      uncurryField h =ᵐ[ν.prod volume] (fun p => H (noiseMap S p.1) p.2.1 p.2.2) ∧
      X =ᵐ[ν] fun ω => Ξ (noiseMap S ω) := by
  have : IsProbabilityMeasure ν := hS.isProbabilityMeasure
  obtain ⟨hfix, hXfix⟩ := hS.walsh_noise_fixed hX
  have hiso := IsWalshIntegral.isometry_lib hS.noiseSheet (isWalshIntegral_noiseSheet_iff.2 hX)
  have h𝒢 := noiseProj_iSup_le (mΩ := mΩ) S ν
  have hNle : MeasurableSpace.comap (noiseMap S) MeasurableSpace.pi ≤ mΩ :=
    hS.noiseMap_comap_le_iSup.trans h𝒢
  -- the value
  have eX := noiseAug_condExp_eq (P := ν) h𝒢 hS.noiseMap_comap_le_iSup
    ((noise_iSup_le_comap S ν).trans (noiseAug_le hNle)) (hiso.2.1.integrable one_le_two)
  obtain ⟨Ξ, hΞ, hΞe⟩ := StronglyMeasurable.exists_eq_measurable_comp
    (mY := MeasurableSpace.pi) (f := noiseMap S)
    (stronglyMeasurable_condExp (m := MeasurableSpace.comap (noiseMap S) MeasurableSpace.pi)
      (μ := ν) (f := X))
  -- the integrand
  set 𝒜 : MeasurableSpace (Ω × ℝ × ℝ) :=
    (MeasurableSpace.comap (noiseMap S) MeasurableSpace.pi).prod inferInstance with h𝒜
  have h1 : 𝒜 ≤ noiseProdSigma S ν := by
    rw [noiseProdSigma_eq]
    exact sup_le_sup (MeasurableSpace.comap_mono hS.noiseMap_comap_le_iSup) le_rfl
  have h2 : noiseProdSigma S ν ≤ noiseAugSets 𝒜 (noiseRefMeasure ν) := by
    rw [noiseProdSigma_eq]
    exact (sup_le_sup (MeasurableSpace.comap_mono (noise_iSup_le_comap S ν)) le_rfl).trans
      (noiseAug_prod hNle)
  have eh := noiseAug_condExp_eq (P := noiseRefMeasure ν) (noiseProdSigma_le S ν) h1 h2
    (noiseProj_integrable hiso.1)
  have h𝒜' : 𝒜 = MeasurableSpace.comap (Prod.map (noiseMap S) id)
      ((MeasurableSpace.pi : MeasurableSpace (ℝ≥0 × ℝ × ℝ → ℝ)).prod inferInstance) := by
    rw [MeasurableSpace.comap_prodMap, MeasurableSpace.comap_id]
  have hGm : StronglyMeasurable[MeasurableSpace.comap (Prod.map (noiseMap S) id)
      ((MeasurableSpace.pi : MeasurableSpace (ℝ≥0 × ℝ × ℝ → ℝ)).prod inferInstance)]
      ((noiseRefMeasure ν)[uncurryField h | 𝒜]) := by
    rw [← h𝒜']
    exact stronglyMeasurable_condExp
  obtain ⟨G, hG, hGe⟩ := StronglyMeasurable.exists_eq_measurable_comp hGm
  refine ⟨fun w s y => G (w, s, y), Ξ, hG.measurable, hΞ.measurable, ?_,
    hXfix.trans (eX.trans (EventuallyEq.of_eq hΞe))⟩
  refine hfix.trans ((noiseRefMeasure_absolutelyContinuous ν).ae_le ?_)
