/-
Lean proof of Theorem 1.2 of G. Barraquand, "Convergence of the one-particle quantum symmetric
simple exclusion process to the KPZ equation" (2026). Written by Claude (Anthropic) at the
request of the author. See README.md and docs/stage3-design.md.
-/
module

public import QSSEPtoKPZ.Tightness.TestFunctions
public import Mathlib.MeasureTheory.Measure.FiniteMeasure
public import Mathlib.MeasureTheory.Constructions.BorelSpace.ContinuousMap
public import Mathlib.MeasureTheory.Constructions.BorelSpace.Metrizable
public import Mathlib.Topology.Metrizable.ContinuousMap
public import Mathlib.Topology.ContinuousMap.SecondCountableSpace
public import Mathlib.Topology.MetricSpace.PiNat
public import Mathlib.Topology.UniformSpace.HeineCantor

/-!
# `ℳ₊(ℝ)` embeds in `ℝ^ℕ`: metrizability, second countability, Borel σ-algebra (task H2)

INTERFACE FILE (task I0' of Stage 3): the statements below are interfaces, proved by task H2.
See `docs/stage3-design.md`, Sections 1.2 (a) and 2.3, and `docs/stage3-interfaces.md`.

Let `f_j = bumpTest j` be the countable family of task H1. The map
`tightEmb : ℳ₊(ℝ) → ℝ^ℕ`, `μ ↦ (∫ f_j dμ)_{j ∈ ℕ}`, is a topological embedding for the topology of
weak convergence on `ℳ₊(ℝ) = FiniteMeasure ℝ`. This rests on one analytic fact (F): if
`∫ f_j dμ_i → ∫ f_j dμ` for every `j` (along any filter), then `μ_i → μ` weakly.

Consequences: `FiniteMeasure ℝ` is second countable and metrizable (instances below, not in
Mathlib); its Borel σ-algebra is generated by the maps `μ ↦ ∫ f_j dμ`; and a map into
`C([0,T], ℳ₊(ℝ))` (Borel σ-algebra of the topology of uniform convergence, Mathlib's instance) is
measurable iff all its test integrals at all times are measurable.

**Warning (two σ-algebras).** Mathlib's `MeasurableSpace (FiniteMeasure ℝ)` instance is the Giry
σ-algebra (generated by `μ ↦ μ(A)`), and Mathlib does not prove that it is the Borel σ-algebra.
The statements here use `borel (FiniteMeasure ℝ)` explicitly, never that instance.
-/

@[expose] public section

open MeasureTheory Filter Topology
open scoped NNReal ENNReal BoundedContinuousFunction

noncomputable section

namespace QSSEPtoKPZ

/-- The embedding `μ ↦ (∫ f_j dμ)_{j ∈ ℕ}` of `ℳ₊(ℝ)` into `ℝ^ℕ`. -/
def tightEmb (μ : FiniteMeasure ℝ) : ℕ → ℝ := fun j => ∫ x, bumpTest j x ∂(μ : Measure ℝ)

/-- Each coordinate `μ ↦ ∫ f_j dμ` of `tightEmb` is continuous (weak convergence).
**(proved)** -/
theorem continuous_tightEmb_apply (j : ℕ) :
    Continuous fun μ : FiniteMeasure ℝ => ∫ x, bumpTest j x ∂(μ : Measure ℝ) :=
  FiniteMeasure.continuous_integral_boundedContinuousFunction (bumpTest j)

/-! ### Proof of (F) -/

/-- The bounded continuous functions `f` with `∫ f dμ_i → ∫ f dμ` along `L` form a submodule. -/
private def tightConvSub {ι : Type*} (L : Filter ι) (μs : ι → FiniteMeasure ℝ)
    (μ : FiniteMeasure ℝ) :
    Submodule ℝ (ℝ →ᵇ ℝ) where
  carrier := {f | Tendsto (fun i => ∫ x, f x ∂(μs i : Measure ℝ)) L
    (𝓝 (∫ x, f x ∂(μ : Measure ℝ)))}
  add_mem' {f g} hf hg := by
    simp only [Set.mem_ofPred_eq, BoundedContinuousFunction.coe_add, Pi.add_apply] at *
    simp_rw [integral_add (f.integrable _) (g.integrable _)]
    exact hf.add hg
  zero_mem' := by simpa using tendsto_const_nhds
  smul_mem' c f hf := by
    simp only [Set.mem_ofPred_eq, BoundedContinuousFunction.coe_smul, smul_eq_mul] at *
    simp_rw [integral_const_mul]
    exact hf.const_mul c

section ProofF

variable {ι : Type*} {L : Filter ι} {μs : ι → FiniteMeasure ℝ} {μ : FiniteMeasure ℝ}

/-- Membership in `tightConvSub` unfolded. -/
private theorem mem_tightConvSub_iff {f : ℝ →ᵇ ℝ} : f ∈ tightConvSub L μs μ ↔
    Tendsto (fun i => ∫ x, f x ∂(μs i : Measure ℝ)) L (𝓝 (∫ x, f x ∂(μ : Measure ℝ))) :=
  Iff.rfl

/-- **Sandwich closure.** If for every `ε > 0` there are `g, k` in the submodule with
`|f - g| ≤ k` pointwise and `∫ k dμ < ε`, then `f` is in the submodule: indeed
`|μ_i(f) - μ(f)| ≤ μ_i(k) + |μ_i(g) - μ(g)| + μ(k)`, and `μ_i(k) → μ(k) < ε`. -/
private theorem tightConvSub_of_approx {f : ℝ →ᵇ ℝ}
    (h : ∀ ε > 0, ∃ g ∈ tightConvSub L μs μ, ∃ k ∈ tightConvSub L μs μ,
      (∀ x, |f x - g x| ≤ k x) ∧ ∫ x, k x ∂(μ : Measure ℝ) < ε) :
    f ∈ tightConvSub L μs μ := by
  rw [mem_tightConvSub_iff, Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨g, hg, k, hk, hfgk, hkε⟩ := h (ε / 3) (by positivity)
  have key : ∀ ν : FiniteMeasure ℝ, |∫ x, f x ∂(ν : Measure ℝ) - ∫ x, g x ∂(ν : Measure ℝ)|
      ≤ ∫ x, k x ∂(ν : Measure ℝ) := by
    intro ν
    rw [← integral_sub (f.integrable _) (g.integrable _)]
    have := norm_integral_le_of_norm_le (μ := (ν : Measure ℝ)) (f := fun x => f x - g x)
      (k.integrable _) (Eventually.of_forall fun x => by simpa [Real.norm_eq_abs] using hfgk x)
    simpa [Real.norm_eq_abs] using this
  have h1 : ∀ᶠ i in L, ∫ x, k x ∂(μs i : Measure ℝ) < ε / 3 :=
    (mem_tightConvSub_iff.1 hk).eventually (gt_mem_nhds hkε)
  have h2 := Metric.tendsto_nhds.1 (mem_tightConvSub_iff.1 hg) (ε / 3) (by positivity)
  filter_upwards [h1, h2] with i h1 h2
  rw [Real.dist_eq] at h2 ⊢
  have k1 := abs_le.1 (key (μs i))
  have k2 := abs_le.1 (key μ)
  have h2' := abs_lt.1 h2
  rw [abs_lt]
  constructor <;> linarith [k1.1, k1.2, k2.1, k2.2, h2'.1, h2'.2]

/-- Evaluation of a finite sum of bounded continuous functions. -/
private theorem bcf_sum_apply {ι' : Type*} (s : Finset ι') (F : ι' → ℝ →ᵇ ℝ) (x : ℝ) :
    (∑ i ∈ s, F i) x = ∑ i ∈ s, F i x := by
  simp

/-- `f_{encode(m,k)+1}(x) = β((m+1)x - k)`. -/
private theorem bumpTest_encode_apply (m : ℕ) (k : ℤ) (x : ℝ) :
    bumpTest (Encodable.encode (m, k) + 1) x = bumpBeta ((m + 1 : ℝ) * x - k) := by
  rw [coe_bumpTest, bumpTestRaw_encode_succ]

/-- `f₀(x) = 1`. -/
private theorem bumpTest_zero_apply (x : ℝ) : bumpTest 0 x = 1 := rfl

/-- **Compactly supported functions.** If every `f_j` is in the submodule, so is every compactly
supported `f ∈ C_b(ℝ)`: with `δ` a modulus of uniform continuity of `f` for `δ'` and
`1/(m+1) < δ`, the finite combination `g(x) = ∑_{|k| ≤ N} f(k/(m+1)) β((m+1)x - k)` satisfies
`|f - g| ≤ δ'`, because `β ≥ 0`, `∑_k β(y - k) = 1` and `β((m+1)x - k) = 0` unless
`|x - k/(m+1)| < 1/(m+1)`. Sandwich with `k = δ' · 1`. -/
private theorem tightConvSub_of_hasCompactSupport (hb : ∀ j, bumpTest j ∈ tightConvSub L μs μ)
    {f : ℝ →ᵇ ℝ} (hf : HasCompactSupport f) : f ∈ tightConvSub L μs μ := by
  refine tightConvSub_of_approx fun ε hε => ?_
  set M : ℝ := (μ : Measure ℝ).real Set.univ
  have hM : 0 ≤ M := measureReal_nonneg
  set δ' : ℝ := ε / (M + 1)
  have hδ' : 0 < δ' := by positivity
  obtain ⟨δ, hδ, hfδ⟩ := Metric.uniformContinuous_iff.1
    (hf.uniformContinuous_of_continuous f.continuous) δ' hδ'
  obtain ⟨m, hm⟩ := exists_nat_one_div_lt hδ
  have hm0 : (0 : ℝ) < m + 1 := by positivity
  obtain ⟨R, hR⟩ := hf.isCompact.isBounded.subset_closedBall 0
  have hzero : ∀ y : ℝ, R < |y| → f y = 0 := fun y hy =>
    image_eq_zero_of_notMem_tsupport fun hy' => by
      have := hR hy'
      rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs] at this
      linarith
  set N : ℤ := ⌈R * (m + 1)⌉
  set F : Finset ℤ := Finset.Icc (-N) N
  refine ⟨∑ k ∈ F, f (k / (m + 1)) • bumpTest (Encodable.encode (m, k) + 1),
    Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _ (hb _), δ' • bumpTest 0,
    Submodule.smul_mem _ _ (hb 0), fun x => ?_, ?_⟩
  · simp only [bcf_sum_apply, BoundedContinuousFunction.coe_smul, smul_eq_mul,
      bumpTest_encode_apply, bumpTest_zero_apply, mul_one]
    set y := (m + 1 : ℝ) * x
    have hs := hasSum_bumpBeta_sub y
    have hg : HasSum (fun k : ℤ => f (k / (m + 1)) * bumpBeta (y - k))
        (∑ k ∈ F, f (k / (m + 1)) * bumpBeta (y - k)) := by
      apply hasSum_sum_of_ne_finset_zero
      intro k hk
      rw [hzero, zero_mul]
      have hk' : N < |k| := by
        simp only [F, Finset.mem_Icc, not_and_or, not_le] at hk
        rcases hk with hk | hk
        · exact lt_of_lt_of_le (by omega) (neg_le_abs k)
        · exact lt_of_lt_of_le hk (le_abs_self k)
      have h1 : R * (m + 1) < |(k : ℝ)| := by
        have : (N : ℝ) + 1 ≤ |(k : ℝ)| := by
          rw [← Int.cast_abs]; exact_mod_cast hk'
        linarith [Int.le_ceil (R * (m + 1))]
      rw [abs_div, abs_of_pos hm0, lt_div_iff₀ hm0]
      exact h1
    have hd : HasSum (fun k : ℤ => (f x - f (k / (m + 1))) * bumpBeta (y - k))
        (f x - ∑ k ∈ F, f (k / (m + 1)) * bumpBeta (y - k)) := by
      have := (hs.mul_left (f x)).sub hg
      simpa [sub_mul, mul_one] using this
    have hle : ∀ k : ℤ, |(f x - f (k / (m + 1))) * bumpBeta (y - k)| ≤
        δ' * bumpBeta (y - k) := by
      intro k
      rw [abs_mul, abs_of_nonneg (bumpBeta_nonneg _)]
      by_cases h1 : 1 ≤ |y - k|
      · rw [bumpBeta_eq_zero_of_one_le_abs h1]; simp
      · push Not at h1
        apply mul_le_mul_of_nonneg_right _ (bumpBeta_nonneg _)
        have hxk : dist x (k / (m + 1)) < δ := by
          rw [Real.dist_eq]
          have : x - k / (m + 1) = (y - k) / (m + 1) := by
            simp only [y]; field_simp
          rw [this, abs_div, abs_of_pos hm0, div_lt_iff₀ hm0]
          rw [div_lt_iff₀ hm0] at hm
          linarith
        have := hfδ hxk
        rw [Real.dist_eq] at this
        exact this.le
    have hδs : HasSum (fun k : ℤ => δ' * bumpBeta (y - k)) δ' := by
      simpa using hs.mul_left δ'
    rw [abs_le]
    exact ⟨hasSum_le (fun k => (abs_le.1 (hle k)).1) hδs.neg hd,
      hasSum_le (fun k => (abs_le.1 (hle k)).2) hd hδs⟩
  · simp only [BoundedContinuousFunction.coe_smul, smul_eq_mul,
      bumpTest_zero_apply, mul_one, integral_const, smul_eq_mul]
    change M * δ' < ε
    rw [mul_div_assoc', div_lt_iff₀ (by positivity)]
    nlinarith

/-- The cutoff `χ_N = ∑_{|k| ≤ N} β(· - k)`. -/
private def tightCutoff (N : ℕ) : ℝ →ᵇ ℝ :=
  ∑ k ∈ Finset.Icc (-(N : ℤ)) N, bumpTest (Encodable.encode (0, k) + 1)

/-- `χ_N(x) = ∑_{|k| ≤ N} β(x - k)`. -/
private theorem tightCutoff_apply (N : ℕ) (x : ℝ) :
    tightCutoff N x = ∑ k ∈ Finset.Icc (-(N : ℤ)) N, bumpBeta (x - k) := by
  rw [tightCutoff, bcf_sum_apply]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [bumpTest_encode_apply]
  simp

/-- `χ_N ≥ 0`. -/
private theorem tightCutoff_nonneg (N : ℕ) (x : ℝ) : 0 ≤ tightCutoff N x := by
  rw [tightCutoff_apply]
  exact Finset.sum_nonneg fun k _ => bumpBeta_nonneg _

/-- `χ_N ≤ 1` (partial sum of the partition of unity). -/
private theorem tightCutoff_le_one (N : ℕ) (x : ℝ) : tightCutoff N x ≤ 1 := by
  rw [tightCutoff_apply]
  exact sum_le_hasSum _ (fun k _ => bumpBeta_nonneg _) (hasSum_bumpBeta_sub x)

/-- `χ_N = 1` on `[-N, N]`. -/
private theorem tightCutoff_eq_one {N : ℕ} {x : ℝ} (hx : |x| ≤ N) : tightCutoff N x = 1 := by
  rw [tightCutoff_apply]
  refine (hasSum_sum_of_ne_finset_zero ?_).unique (hasSum_bumpBeta_sub x)
  intro k hk
  apply bumpBeta_eq_zero_of_one_le_abs
  have hk' : (N : ℤ) < |k| := by
    simp only [Finset.mem_Icc, not_and_or, not_le] at hk
    rcases hk with hk | hk
    · exact lt_of_lt_of_le (by omega) (neg_le_abs k)
    · exact lt_of_lt_of_le hk (le_abs_self k)
  have h1 : (N : ℝ) + 1 ≤ |(k : ℝ)| := by
    rw [← Int.cast_abs]; exact_mod_cast hk'
  have := abs_sub_abs_le_abs_sub (k : ℝ) x
  rw [abs_sub_comm] at this
  linarith

/-- `χ_N = 0` outside `(-(N+1), N+1)`. -/
private theorem tightCutoff_eq_zero {N : ℕ} {x : ℝ} (hx : N + 1 ≤ |x|) : tightCutoff N x = 0 := by
  rw [tightCutoff_apply]
  refine Finset.sum_eq_zero fun k hk => bumpBeta_eq_zero_of_one_le_abs ?_
  rw [Finset.mem_Icc] at hk
  have hk' : |k| ≤ (N : ℤ) := abs_le.2 hk
  have h1 : |(k : ℝ)| ≤ N := by
    rw [← Int.cast_abs]; exact_mod_cast hk'
  have := abs_sub_abs_le_abs_sub x (k : ℝ)
  linarith

/-- `χ_N` is a finite combination of the `f_j`. -/
private theorem tightCutoff_mem (hb : ∀ j, bumpTest j ∈ tightConvSub L μs μ) (N : ℕ) :
    tightCutoff N ∈ tightConvSub L μs μ :=
  Submodule.sum_mem _ fun _ _ => hb _

/-- `∫ (1 - χ_N) dμ → 0` as `N → ∞` (dominated convergence). -/
private theorem tendsto_integral_one_sub_tightCutoff (μ : FiniteMeasure ℝ) :
    Tendsto (fun N : ℕ => ∫ x, (1 - tightCutoff N x) ∂(μ : Measure ℝ)) atTop (𝓝 0) := by
  have h0 : (0 : ℝ) = ∫ _, (0 : ℝ) ∂(μ : Measure ℝ) := by simp
  rw [h0]
  refine tendsto_integral_of_dominated_convergence (fun _ => (1 : ℝ)) (fun N => ?_)
    (integrable_const _) (fun N => ?_) ?_
  · exact (continuous_const.sub (tightCutoff N).continuous).aestronglyMeasurable
  · refine Eventually.of_forall fun x => ?_
    rw [Real.norm_eq_abs, abs_le]
    constructor <;> linarith [tightCutoff_nonneg N x, tightCutoff_le_one N x]
  · refine Eventually.of_forall fun x => tendsto_const_nhds.congr' ?_
    filter_upwards [eventually_ge_atTop ⌈|x|⌉₊] with N hN
    rw [tightCutoff_eq_one (Nat.ceil_le.1 hN)]
    ring

/-- **(F), core.** If every `f_j` is in the submodule, so is every `f ∈ C_b(ℝ)`: sandwich with
`g = f χ_N` (compactly supported) and `k = ‖f‖ (1 - χ_N)`. -/
private theorem mem_tightConvSub (hb : ∀ j, bumpTest j ∈ tightConvSub L μs μ) (f : ℝ →ᵇ ℝ) :
    f ∈ tightConvSub L μs μ := by
  refine tightConvSub_of_approx fun ε hε => ?_
  obtain ⟨N, hN⟩ := ((tendsto_integral_one_sub_tightCutoff μ).eventually
    (gt_mem_nhds (show (0 : ℝ) < ε / (‖f‖ + 1) by positivity))).exists
  have hone : (1 : ℝ →ᵇ ℝ) ∈ tightConvSub L μs μ := by
    have : (1 : ℝ →ᵇ ℝ) = bumpTest 0 := by ext x; rfl
    rw [this]; exact hb 0
  refine ⟨f * tightCutoff N, tightConvSub_of_hasCompactSupport hb ?_, ‖f‖ • (1 - tightCutoff N),
    Submodule.smul_mem _ _ (Submodule.sub_mem _ hone (tightCutoff_mem hb N)), fun x => ?_, ?_⟩
  · refine HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) (N + 1)) fun x hx => ?_
    rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs, not_le] at hx
    simp [tightCutoff_eq_zero hx.le]
  · simp only [BoundedContinuousFunction.coe_mul, BoundedContinuousFunction.coe_smul,
      BoundedContinuousFunction.coe_sub, BoundedContinuousFunction.coe_one, Pi.mul_apply,
      Pi.sub_apply, Pi.one_apply, smul_eq_mul]
    rw [show f x - f x * tightCutoff N x = f x * (1 - tightCutoff N x) by ring, abs_mul,
      abs_of_nonneg (sub_nonneg.2 (tightCutoff_le_one N x))]
    exact mul_le_mul_of_nonneg_right (by simpa [Real.norm_eq_abs] using f.norm_coe_le_norm x)
      (sub_nonneg.2 (tightCutoff_le_one N x))
  · simp only [BoundedContinuousFunction.coe_smul, BoundedContinuousFunction.coe_sub,
      BoundedContinuousFunction.coe_one, Pi.sub_apply, Pi.one_apply, smul_eq_mul]
    rw [integral_const_mul]
    have h1 := mul_le_mul_of_nonneg_left hN.le (norm_nonneg f)
    have h2 : ‖f‖ * (ε / (‖f‖ + 1)) < ε := by
      rw [mul_div_assoc', div_lt_iff₀ (by positivity)]
      nlinarith
    linarith

end ProofF

/-- **(F): the family `(f_j)` determines weak convergence.** If `∫ f_j dμ_i → ∫ f_j dμ` along a
filter `L` for every `j`, then `μ_i → μ` weakly along `L`. -/
theorem tightEmb_tendsto_of_forall {ι : Type*} {L : Filter ι}
    {μs : ι → FiniteMeasure ℝ} {μ : FiniteMeasure ℝ}
    (h : ∀ j, Tendsto (fun i => ∫ x, bumpTest j x ∂(μs i : Measure ℝ)) L
      (𝓝 (∫ x, bumpTest j x ∂(μ : Measure ℝ)))) :
    Tendsto μs L (𝓝 μ) :=
  FiniteMeasure.tendsto_iff_forall_integral_tendsto.2 fun f => mem_tightConvSub h f

/-- `μ ↦ (∫ f_j dμ)_j` is continuous into `ℝ^ℕ` (product topology). -/
theorem continuous_tightEmb : Continuous tightEmb := continuous_pi continuous_tightEmb_apply

/-- `μ ↦ (∫ f_j dμ)_j` is a homeomorphism of `ℳ₊(ℝ)` onto its image in `ℝ^ℕ`
(product topology). -/
theorem isEmbedding_tightEmb : IsEmbedding tightEmb := by
  refine IsInducing.isEmbedding (isInducing_iff_nhds.2 fun μ => le_antisymm ?_ ?_)
  · exact (continuous_tightEmb.tendsto μ).le_comap
  · exact tendsto_id'.1 (tightEmb_tendsto_of_forall (μs := id) fun j =>
      ((continuous_apply j).tendsto (tightEmb μ)).comp tendsto_comap)

/-- `ℳ₊(ℝ)` is second countable (it embeds in `ℝ^ℕ`). -/
instance tightEmb_secondCountableTopology : SecondCountableTopology (FiniteMeasure ℝ) :=
  isEmbedding_tightEmb.isInducing.secondCountableTopology

/-- `ℳ₊(ℝ)` is metrizable (it embeds in `ℝ^ℕ`). -/
instance tightEmb_metrizableSpace : TopologicalSpace.MetrizableSpace (FiniteMeasure ℝ) :=
  isEmbedding_tightEmb.metrizableSpace

/-- The Borel σ-algebra of `ℳ₊(ℝ)` (weak topology) is generated by the maps `μ ↦ ∫ f_j dμ`. -/
theorem borel_finiteMeasure_eq_iSup_tightEmb :
    borel (FiniteMeasure ℝ) =
      ⨆ j, (borel ℝ).comap fun μ : FiniteMeasure ℝ => ∫ x, bumpTest j x ∂(μ : Measure ℝ) := by
  have h1 : borel (FiniteMeasure ℝ) = (borel (ℕ → ℝ)).comap tightEmb := by
    rw [← borel_comap, ← isEmbedding_tightEmb.eq_induced]
  rw [h1, ← BorelSpace.measurable_eq (α := ℕ → ℝ), MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  simp_rw [MeasurableSpace.comap_comp]
  rfl

/-- A map into `ℳ₊(ℝ)` is Borel measurable iff all its test integrals are measurable. -/
theorem measurable_finiteMeasure_iff_tightEmb {Z : Type*} [MeasurableSpace Z]
    {g : Z → FiniteMeasure ℝ} :
    Measurable[_, borel (FiniteMeasure ℝ)] g ↔
      ∀ j : ℕ, Measurable fun z => ∫ x, bumpTest j x ∂(g z : Measure ℝ) := by
  rw [measurable_iff_comap_le, borel_finiteMeasure_eq_iSup_tightEmb, MeasurableSpace.comap_iSup,
    iSup_le_iff]
  simp_rw [MeasurableSpace.comap_comp, ← measurable_iff_comap_le]
  rfl

/-- The Borel σ-algebra of `C([0,T], ℳ₊(ℝ))` (Mathlib's instance: Borel σ-algebra of the
compact-open topology, i.e. of uniform convergence) is generated by the maps
`γ ↦ ∫ f_j dγ(t)`, `t ∈ [0,T]`, `j ∈ ℕ`. -/
theorem borel_pathFiniteMeasure_eq_iSup_tightEmb (T : ℝ) :
    (inferInstance : MeasurableSpace C(Set.Icc (0 : ℝ) T, FiniteMeasure ℝ)) =
      ⨆ (t : Set.Icc (0 : ℝ) T) (j : ℕ), (borel ℝ).comap
        fun γ : C(Set.Icc (0 : ℝ) T, FiniteMeasure ℝ) => ∫ x, bumpTest j x ∂(γ t : Measure ℝ) := by
  change borel _ = _
  rw [ContinuousMap.borel_eq_iSup_comap_eval]
  refine iSup_congr fun t => ?_
  rw [borel_finiteMeasure_eq_iSup_tightEmb, MeasurableSpace.comap_iSup]
  simp_rw [MeasurableSpace.comap_comp]
  rfl

/-- **Measurability of a random path in `C([0,T], ℳ₊(ℝ))`** (for the instance used by the frozen
statement): `g` is measurable iff `z ↦ ∫ f_j d(g z)(t)` is measurable for every `t ∈ [0,T]` and
every `j`. -/
theorem measurable_pathFiniteMeasure_iff_tightEmb {Z : Type*} [MeasurableSpace Z] {T : ℝ}
    {g : Z → C(Set.Icc (0 : ℝ) T, FiniteMeasure ℝ)} :
    Measurable g ↔ ∀ (t : Set.Icc (0 : ℝ) T) (j : ℕ),
      Measurable fun z => ∫ x, bumpTest j x ∂(g z t : Measure ℝ) := by
  have h : (ContinuousMap.measurableSpace : MeasurableSpace C(Set.Icc (0 : ℝ) T, FiniteMeasure ℝ))
      = _ := borel_pathFiniteMeasure_eq_iSup_tightEmb T
  rw [measurable_iff_comap_le, h]
  simp_rw [MeasurableSpace.comap_iSup, iSup_le_iff, MeasurableSpace.comap_comp,
    ← measurable_iff_comap_le]
  rfl

end QSSEPtoKPZ
