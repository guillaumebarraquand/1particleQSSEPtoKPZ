/-
Lean proof of Theorem 1.2 of G. Barraquand, "Convergence of the one-particle quantum symmetric
simple exclusion process to the KPZ equation" (2026). Written by Claude (Anthropic) at the
request of the author. See README.md and docs/stage2-design.md.
-/
module

public import QSSEPtoKPZ.Definitions
public import Mathlib.Probability.Martingale.OptionalSampling
public import Mathlib.Probability.Martingale.OptionalStopping
public import Mathlib.Probability.Process.HittingTime
public import Mathlib.MeasureTheory.Constructions.Polish.StronglyMeasurable
public import Mathlib.Probability.Independence.Basic

/-!
# Basic definitions for martingales in continuous time (Stage 2, package B)

These definitions are used in the statements of the article's results of Stage 2
(`docs/stage2-design.md`, Section 1.2 (a), (b)): the usual conditions are not assumed, and
"martingale" and "bracket" are understood up to null sets, with respect to the given
filtration.

* `nullAug μ 𝓕`: the filtration `𝓕_t ∨ σ(μ-null sets)`.
* `timeChange c 𝓕`: the filtration `t ↦ 𝓕_{c t}`.
* `IsCL2Mart T 𝓕 M μ`: `M` is a continuous square-integrable martingale on `[0, T]`.
* `HasBracket T 𝓕 M A μ`: moreover `⟨M⟩ = A` on `[0, T]`, i.e. `A` is continuous,
  nondecreasing, starts from `0`, and `M² - A` is a martingale.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal

noncomputable section

namespace QSSEPtoKPZ

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

/-- The σ-algebra generated by the `μ`-null sets of `mΩ`. -/
@[instance_reducible] def nullSets (μ : Measure Ω) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {s | MeasurableSet s ∧ μ s = 0}

lemma nullSets_le (μ : Measure Ω) : nullSets (mΩ := mΩ) μ ≤ mΩ :=
  MeasurableSpace.generateFrom_le fun _ hs => hs.1

/-- The augmentation of `𝓕` by the null sets: `𝓕ᵃ_t = 𝓕_t ∨ σ(null sets)`. -/
def nullAug (μ : Measure Ω) (𝓕 : Filtration ℝ≥0 mΩ) : Filtration ℝ≥0 mΩ where
  seq t := 𝓕 t ⊔ nullSets μ
  mono' _ _ h := sup_le_sup_right (𝓕.mono h) _
  le' t := sup_le (𝓕.le t) (nullSets_le μ)

lemma le_nullAug (μ : Measure Ω) (𝓕 : Filtration ℝ≥0 mΩ) : 𝓕 ≤ nullAug μ 𝓕 :=
  fun _ => le_sup_left

set_option linter.unusedVariables false in
/-- The time-changed filtration `t ↦ 𝓕 (c t)`. -/
def timeChange (c : ℝ≥0) (𝓕 : Filtration ℝ≥0 mΩ) : Filtration ℝ≥0 mΩ where
  seq t := 𝓕 (c * t)
  mono' _ _ h := 𝓕.mono (mul_le_mul_of_nonneg_left h c.2)
  le' t := 𝓕.le _

/-- `M` is a continuous square-integrable martingale on `[0, T]` with respect to `𝓕`, up to
null sets: almost surely `t ↦ M_t` is continuous on `[0, T]`; `M_t ∈ L²` for `0 ≤ t ≤ T`; and
`𝔼[M_t | 𝓕_s] = M_s` almost surely for `0 ≤ s ≤ t ≤ T` (for `s = t`, this says that `M_t` is
`𝓕_t`-measurable up to a null set). -/
structure IsCL2Mart (T : ℝ) (𝓕 : Filtration ℝ≥0 mΩ) (M : ℝ → Ω → ℝ) (μ : Measure Ω) :
    Prop where
  cont : ∀ᵐ ω ∂μ, ContinuousOn (fun t => M t ω) (Set.Icc 0 T)
  memLp : ∀ t : ℝ≥0, (t : ℝ) ≤ T → MemLp (M t) 2 μ
  condExp : ∀ s t : ℝ≥0, s ≤ t → (t : ℝ) ≤ T → μ[M t | 𝓕 s] =ᵐ[μ] M s

/-- `⟨M⟩_t = A_t` on `[0, T]`: `M` is a continuous square-integrable martingale on `[0, T]`, and
`A` is integrable, almost surely continuous and nondecreasing on `[0, T]` with `A_0 = 0`, and
`M² - A` is a martingale on `[0, T]` (up to null sets, as in `IsCL2Mart`). -/
structure HasBracket (T : ℝ) (𝓕 : Filtration ℝ≥0 mΩ) (M A : ℝ → Ω → ℝ) (μ : Measure Ω) :
    Prop extends IsCL2Mart T 𝓕 M μ where
  integrable_bracket : ∀ t : ℝ≥0, (t : ℝ) ≤ T → Integrable (A t) μ
  zero : ∀ᵐ ω ∂μ, A 0 ω = 0
  mono : ∀ᵐ ω ∂μ, MonotoneOn (fun t => A t ω) (Set.Icc 0 T)
  cont_bracket : ∀ᵐ ω ∂μ, ContinuousOn (fun t => A t ω) (Set.Icc 0 T)
  condExp_sq : ∀ s t : ℝ≥0, s ≤ t → (t : ℝ) ≤ T →
    μ[fun ω => M t ω ^ 2 - A t ω | 𝓕 s] =ᵐ[μ] fun ω => M s ω ^ 2 - A s ω


end QSSEPtoKPZ
